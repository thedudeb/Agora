AGORA_API_PORT=8787
AGORA_APP_PORT=5174
AGORA_STORAGE_DRIVER=json
AGORA_AUTH_DRIVER=local
AGORA_WORKSPACE_ID=workspace-acme
AGORA_SESSION_TTL_SECONDS=28800
AGORA_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
AGORA_INVITATION_TTL_DAYS=14
AGORA_PASSWORD_RESET_TTL_MINUTES=30
AGORA_PUBLIC_APP_URL=http://127.0.0.1:5174
AGORA_EMAIL_FROM=Agora <no-reply@example.com>
# Delivery options: manual, smtp, webhook. Use manual only for local/admin recovery.
AGORA_PASSWORD_RESET_DELIVERY=manual
# Local/manual deployments can return reset tokens in API responses.
# Keep false when smtp/webhook delivery handles tokens.
AGORA_PASSWORD_RESET_RETURN_TOKEN=false
AGORA_PASSWORD_RESET_WEBHOOK_URL=
AGORA_PASSWORD_RESET_WEBHOOK_SECRET=
AGORA_SMTP_HOST=
AGORA_SMTP_PORT=587
AGORA_SMTP_SECURE=false
AGORA_SMTP_STARTTLS=true
AGORA_SMTP_USER=
AGORA_SMTP_PASSWORD=

# Demo and passwordless email auth are disabled by default for safer self-hosting.
# Turn these on only for local demos or trusted internal workspaces.
AGORA_DEMO_AUTH=false
AGORA_PASSWORDLESS_AUTH=false

# Supabase storage
# 1. Run server/migrations/001_supabase_storage.sql and 002_supabase_auth_rls.sql.
# 2. Change AGORA_STORAGE_DRIVER to supabase.
# 3. To use Supabase email/password auth or accept Supabase Auth access tokens,
#    change AGORA_AUTH_DRIVER to supabase.
# 4. Use the service role key only on the server. Never expose it in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me
AGORA_SUPABASE_STORAGE_BUCKET=agora-files

# Optional server-side AI operator adapter
# Provider options: local, openai, ollama, custom
AGORA_AI_PROVIDER=local
AGORA_AI_MODEL=Agora deterministic operator
AGORA_AI_BASE_URL=
AGORA_AI_API_KEY=
# Set to true only for trusted self-hosted workspaces that should allow
# browser-saved AI base URLs to override AGORA_AI_BASE_URL.
AGORA_AI_ALLOW_CLIENT_BASE_URL=false
