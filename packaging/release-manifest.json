{
  "type": "agora.release-manifest",
  "version": 1,
  "productVersion": "0.1.0",
  "releaseStatus": "beta-ready packaging path, not a signed public app-store release",
  "releaseOwner": "Agora maintainer",
  "releaseGate": [
    "npm run release:check",
    "npm run demo:check",
    "npm run package:check",
    "npm run trust",
    "npm run verify:production -- --env .env.production --backup <server-backup.json> --bundle <portable-workspace-bundle.json> --strict",
    "npm run qa",
    "npm run security"
  ],
  "handoffArtifacts": [
    "README.md",
    "docs/install.md",
    "docs/hosted-provider-recipes.md",
    "docs/packaging.md",
    "docs/release-candidate-v0.1-beta.md",
    "docs/release-candidate-handoff-template.md",
    "docs/release-checklist.md",
    "docs/trust-center.md",
    "packaging/release-manifest.json"
  ],
  "knownGaps": [
    "Desktop builds require platform-specific packaging and code signing before broad public distribution.",
    "Native iOS and Android wrappers are not included yet; the current mobile install path is the offline PWA.",
    "Hosted production launches still require operator-provided Supabase, SMTP/webhook, backup, and domain configuration.",
    "Real production upgrades should use a fresh server backup instead of --allow-missing-backup dry runs."
  ],
  "requiredRootCommands": [
    "setup",
    "start",
    "start:api",
    "agora",
    "demo:check",
    "mcp",
    "trust",
    "qa",
    "security",
    "release:check",
    "verify:hosted",
    "verify:production",
    "verify:upgrade",
    "drill:recovery",
    "package:check",
    "test:mcp",
    "test:fixtures"
  ],
  "requiredDesktopCommands": [
    "pack:mac",
    "pack:win",
    "dist"
  ],
  "channels": [
    {
      "id": "source",
      "label": "Source install",
      "artifactType": "Git checkout or source archive",
      "platforms": ["macOS", "Windows", "Linux"],
      "entrypoint": "npm run setup",
      "requiredFiles": ["package.json", "package-lock.json", "scripts/agora-setup.js", "docs/install.md"],
      "verification": ["npm run setup -- --dry-run", "npm run check"]
    },
    {
      "id": "docker-compose",
      "label": "Docker Compose",
      "artifactType": "Container image plus compose stack",
      "platforms": ["macOS", "Windows", "Linux", "server"],
      "entrypoint": "docker compose up --build",
      "requiredFiles": ["Dockerfile", "docker-compose.yml", ".dockerignore", "docs/install.md"],
      "verification": ["npm run setup -- --profile docker --dry-run", "docker compose config"]
    },
    {
      "id": "hosted",
      "label": "Hosted web/API deployment",
      "artifactType": "Static web app plus long-running API service",
      "platforms": ["Vercel", "Render", "Fly.io", "Railway", "Node host"],
      "entrypoint": "npm run start && npm run start:api",
      "requiredFiles": ["vercel.json", "server/api.js", "server/static.js", "docs/deployment.md", "docs/hosted-launch-runbook.md"],
      "verification": ["npm run verify:hosted", "npm run rehearse:hosted"]
    },
    {
      "id": "pwa-offline",
      "label": "Offline PWA",
      "artifactType": "Installable browser app",
      "platforms": ["iOS", "Android", "desktop browser"],
      "entrypoint": "Open hosted app and install from browser",
      "requiredFiles": ["manifest.webmanifest", "sw.js", "offline.html", "assets/icons/agora-192.png", "assets/icons/agora-512.png"],
      "verification": ["npm run test:golden"]
    },
    {
      "id": "desktop-macos",
      "label": "macOS desktop shell",
      "artifactType": "DMG and ZIP",
      "platforms": ["macOS"],
      "entrypoint": "npm --prefix desktop run pack:mac",
      "requiredFiles": ["desktop/package.json", "desktop/package-lock.json", "desktop/electron/main.cjs", "desktop/electron/preload.cjs", "docs/desktop-app.md"],
      "verification": ["npm run check", "npm --prefix desktop run pack:mac"]
    },
    {
      "id": "desktop-windows",
      "label": "Windows desktop shell",
      "artifactType": "NSIS installer and portable executable",
      "platforms": ["Windows"],
      "entrypoint": "npm --prefix desktop run pack:win",
      "requiredFiles": ["desktop/package.json", "desktop/package-lock.json", "desktop/electron/main.cjs", "desktop/electron/preload.cjs", "docs/desktop-app.md"],
      "verification": ["npm run check", "npm --prefix desktop run pack:win"]
    },
    {
      "id": "cli",
      "label": "Agora CLI",
      "artifactType": "Node.js command wrapper",
      "platforms": ["macOS", "Windows", "Linux"],
      "entrypoint": "npm run agora -- help",
      "requiredFiles": ["scripts/agora-cli.js", "README.md", "docs/install.md"],
      "verification": ["npm run agora -- verify --quick", "npm run agora -- package-check --json"]
    },
    {
      "id": "mcp-server",
      "label": "Local MCP server",
      "artifactType": "stdio MCP server for local power-user clients",
      "platforms": ["macOS", "Windows", "Linux"],
      "entrypoint": "npm run mcp",
      "requiredFiles": ["scripts/agora-mcp-server.js", "docs/mcp-server.md", "docs/mcp-security-audit.md"],
      "verification": ["npm run test:mcp"]
    },
    {
      "id": "portable-data",
      "label": "Portable workspace bundle",
      "artifactType": "JSON/CSV/Markdown workspace export",
      "platforms": ["Agora web", "Agora desktop", "future mobile shells"],
      "entrypoint": "Data > Portable workspace bundle",
      "requiredFiles": ["docs/portable-workspace.md", "tests/fixtures/portable-workspace-bundle.json", "server/portable-fixtures-test.js"],
      "verification": ["npm run test:fixtures", "npm run agora -- bundle inspect tests/fixtures/portable-workspace-bundle.json"]
    }
  ]
}
