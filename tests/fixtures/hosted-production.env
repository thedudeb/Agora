AGORA_STORAGE_DRIVER=supabase
AGORA_AUTH_DRIVER=supabase
AGORA_ALLOWED_ORIGINS=https://agora.example.test
AGORA_ALLOW_LOCALHOST_ORIGINS=false
AGORA_PUBLIC_APP_URL=https://agora.example.test
AGORA_STRICT_CSP=true
AGORA_STRUCTURED_LOGS=true
AGORA_BACKUP_DIR=/var/lib/agora/backups
AGORA_BACKUP_RETENTION_FILES=20
AGORA_BACKUP_DISABLED=false
AGORA_BACKUP_SCHEDULER_ENABLED=true
AGORA_DEMO_AUTH=false
AGORA_PASSWORDLESS_AUTH=false
AGORA_SESSION_TTL_SECONDS=28800
AGORA_INVITATION_TTL_DAYS=14
AGORA_PASSWORD_RESET_TTL_MINUTES=30
AGORA_PASSWORD_RESET_DELIVERY=smtp
AGORA_PASSWORD_RESET_RETURN_TOKEN=false
AGORA_EMAIL_FROM=Agora <no-reply@example.test>
AGORA_FEATURE_REQUEST_EMAIL=owner@example.test
AGORA_PORTAL_ACTION_EMAIL=owner@example.test
AGORA_SMTP_HOST=smtp.example.test
AGORA_SMTP_USER=fake-smtp-user
AGORA_SMTP_PASSWORD=fake-smtp-password
AGORA_SMTP_PORT=587
AGORA_SMTP_SECURE=false
AGORA_SMTP_STARTTLS=true
AGORA_AI_PROVIDER=local
AGORA_AI_ALLOW_CLIENT_BASE_URL=false
AGORA_AI_ALLOWED_BASE_URLS=
AGORA_PUBLIC_FEATURE_REQUESTS=false
AGORA_PUBLIC_FEATURE_RATE_LIMIT_ATTEMPTS=6
AGORA_PUBLIC_FEATURE_EMAIL_RATE_LIMIT_ATTEMPTS=3
AGORA_PUBLIC_FEATURE_BODY_LIMIT_BYTES=24576
AGORA_RATE_LIMIT_DRIVER=supabase
AGORA_GITHUB_WEBHOOK_SECRET=fake-github-webhook-secret
SUPABASE_URL=https://project.supabase.co
SUPABASE_ANON_KEY=fake-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=fake-supabase-service-role-key
AGORA_SUPABASE_STORAGE_BUCKET=agora-files
