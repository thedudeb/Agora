      "url": "./#daily",
      "icons": [{ "src": "./assets/icons/agora-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "description": "Open workspace notifications.",
      "url": "./#inbox",
      "icons": [{ "src": "./assets/icons/agora-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Task",
      "short_name": "Task",
