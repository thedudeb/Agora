{
  "name": "Agora Project Management",
  "short_name": "Agora",
  "id": "./",
  "description": "Open source project management for teams that want clarity without lock-in.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#f6f5f0",
  "theme_color": "#245a58",
  "orientation": "any",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icons/agora-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/agora-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/agora-mark.svg",
      "sizes": "64x64",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshots/agora-mobile-today.png",
      "sizes": "500x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Plan mobile work offline from Today."
    },
    {
      "src": "./assets/screenshots/agora-mobile-launch.png",
      "sizes": "500x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Review launch readiness from an Android home-screen install."
    },
    {
      "src": "./assets/screenshots/agora-acme-command-center.png",
      "sizes": "1265x712",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Triage an Acme client launch from the Agora command center."
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
