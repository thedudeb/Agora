{
  "name": "agora-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Optional Windows and macOS desktop shell for Agora.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack:mac": "electron-builder --mac",
    "pack:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.agora.desktop",
    "productName": "Agora",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "app-root/index.html"
      },
      {
        "from": "../offline.html",
        "to": "app-root/offline.html"
      },
      {
        "from": "../manifest.webmanifest",
        "to": "app-root/manifest.webmanifest"
      },
      {
        "from": "../sw.js",
        "to": "app-root/sw.js"
      },
      {
        "from": "../assets",
        "to": "app-root/assets"
      },
      {
        "from": "../src",
        "to": "app-root/src"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
